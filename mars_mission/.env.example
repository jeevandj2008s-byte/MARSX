# ==============================================================================
# NASA Space Apps Challenge 2026 - ROVERSE Mars Surface Exploration Planning
# Multi-Provider AI Fallback Chain Configuration
# ==============================================================================
# The backend tries configured providers in order. On failure or rate-limit, it
# transparently falls to the next provider. The final 'offline' tier needs zero internet.

# Provider Fallback Order (comma-separated: gemini, groq, openrouter, mistral, ollama, offline)
AI_PROVIDER_ORDER=gemini,groq,openrouter,ollama,offline

# ------------------------------------------------------------------------------
# 1. Google Gemini (Official google-genai SDK)
# Free key: https://aistudio.google.com/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 2. Groq (Ultra-fast, OpenAI-compatible)
# Free key: https://console.groq.com/keys
# ------------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_2=openai/gpt-oss-20b

# ------------------------------------------------------------------------------
# 3. OpenRouter (Multi-model free tier router, OpenAI-compatible)
# Free key: https://openrouter.ai/keys
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODELS=openai/gpt-oss-120b:free,google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free,openrouter/free
APP_HTTP_REFERER=https://github.com/nasa-spaceapps-2026/roverse
APP_TITLE=ROVERSE Mars Exploration Planning System

# ------------------------------------------------------------------------------
# 4. Mistral AI (Optional OpenAI-compatible)
# Free key: https://console.mistral.ai
# ------------------------------------------------------------------------------
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=mistral-small-latest

# ------------------------------------------------------------------------------
# 5. Ollama (Optional Local Offline Model)
# Download: https://ollama.ai
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4

# ------------------------------------------------------------------------------
# 6. Reliability & Timeouts
# ------------------------------------------------------------------------------
# Offline / Presentation Reliability Mode (forces offline fallback if true)
DEMO_MODE=false

REQUEST_TIMEOUT_SECONDS=15
OVERALL_REQUEST_BUDGET_SECONDS=20
CIRCUIT_BREAKER_FAILURES=3
CIRCUIT_BREAKER_RESET_SECONDS=60
CACHE_TTL_SECONDS=3600

# Server Configuration
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
